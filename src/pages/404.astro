---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found | Avijit Saha" description="That page does not exist." noindex>
  <main id="main" class="section" style="padding-top: calc(var(--header-h) + 80px)">
    <div class="container" style="text-align: center">
      <p class="eyebrow" style="justify-content: center"><span>404</span> Not found</p>
      <h1 style="margin-top: 12px">This page took a wrong turn</h1>
      <p class="section-sub" style="margin: 14px auto 28px">
        The link may be broken or the page may have moved. The portfolio is one page — everything is
        back on the home screen.
      </p>
      <a class="btn btn-primary" href="/">
        <Icon name="arrow-left" />
        Back to the portfolio
      </a>
    </div>
  </main>
</BaseLayout>
