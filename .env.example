# ---------------------------------------------------------------------------
# Supabase
# Create a project at https://supabase.com/dashboard, then copy the values from
# Project Settings -> API Keys into this file and rename it to `.env`.
# ---------------------------------------------------------------------------

# Public project URL, safe to expose to the browser.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (starts with `sb_publishable_`), safe to expose to the browser.
# Older projects call this the `anon` key (a JWT starting with `eyJ`).
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only secret key (starts with `sb_secret_`), or the legacy
# `service_role` JWT. NEVER expose this to the client and never commit it.
# If you only have the publishable key, leave this blank: the app falls back to
# the anon key + Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
